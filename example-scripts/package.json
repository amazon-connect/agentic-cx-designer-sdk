    "autocare:flow": "node autocare-voice-assistant/flow.js",
    "autocare:guardrail": "node autocare-voice-assistant/guardrail.js",
    "autocare:app": "node autocare-voice-assistant/application.js",
    "trailhead:create": "node trailhead-assistant/create.js",
    "trailhead:build-deploy": "node trailhead-assistant/build-deploy.js",
    "trailhead:kb": "node trailhead-assistant/kb.js",
    "trailhead:slot": "node trailhead-assistant/slot-type.js",
    "trailhead:flow": "node trailhead-assistant/flow.js",
    "trailhead:app": "node trailhead-assistant/application.js",
    "order:create": "node order-lookup-assistant/create.js",
    "order:build-deploy": "node order-lookup-assistant/build-deploy.js",
    "order:datarequest": "node order-lookup-assistant/data-request.js",
