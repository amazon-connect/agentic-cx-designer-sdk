# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ACXD API key (format: acxd_live_<prefix>.<secret>)
ACXD_API_KEY=

# Workspace to operate in (sent as the x-workspace-id header on every request)
ACXD_WORKSPACE_ID=

# Region hosting the ACXD Platform SDK endpoint (e.g. ca-central-1)
ACXD_REGION=ca-central-1
