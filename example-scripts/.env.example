# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ACXD API key (format: acxd_live_<prefix>.<secret>)
ACXD_API_KEY=

# Workspace to operate in (sent as the x-workspace-id header on every request)
ACXD_WORKSPACE_ID=

# Region hosting the ACXD Platform SDK endpoint (e.g. ca-central-1)
ACXD_REGION=ca-central-1

# Optional. Overrides the endpoint the client resolves from ACXD_REGION, which
# is the production host. Non-production inserts the stage into the parent zone:
#   https://api.acxd.connect-beta.<region>.amazonaws.com
#   https://api.acxd.connect-gamma.<region>.amazonaws.com
# An API key is issued per workspace per stage, so the key and the endpoint have
# to agree.
ACXD_ENDPOINT=
